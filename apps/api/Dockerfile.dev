# Chess Engine API — development image (local dev only).
# Installs the Stockfish binary so engine moves + benchmarks work out of the box.
# GPL-3.0 (REL-011): the binary is installed from the distro at build time and is
# NOT redistributed by this repo. Production intentionally omits it (see Dockerfile).
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Stockfish from Debian/Ubuntu packages (BEN-001). Dev-only convenience layer.
RUN apt-get update \
    && apt-get install -y --no-install-recommends stockfish \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv/api

# Install runtime deps first for layer caching.
COPY pyproject.toml README.md ./
COPY app ./app
RUN pip install --no-cache-dir .

# Migrations ship with the image; applied as a controlled deploy step (REL-006).
COPY alembic ./alembic
COPY alembic.ini ./alembic.ini

EXPOSE 8000

# Default: migrate then serve. Compose overrides keep this contract.
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000"]